<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.enrigle.wallabump</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/enrigle/Documents/code/wallapop/.venv/bin/python</string>
        <string>/Users/enrigle/Documents/code/wallapop/bump.py</string>
        <string>run</string>
        <string>--publish</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/enrigle/Documents/code/wallapop</string>

    <!-- Thursday (4) and Sunday (0) at 21:55, local time.

         Evening on purpose: a laptop is usually open and genuinely awake then.
         A morning slot relied on a pmset scheduled wake, which on battery only
         produces a DarkWake - a few seconds of CPU before the machine sleeps
         again - and that is not enough to edit a catalog. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>21</integer>
            <key>Minute</key><integer>55</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>0</integer>
            <key>Hour</key><integer>21</integer>
            <key>Minute</key><integer>55</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardErrorPath</key>
    <string>/Users/enrigle/.wallapop-bump/launchd.err</string>

    <key>StandardOutPath</key>
    <string>/Users/enrigle/.wallapop-bump/launchd.out</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
